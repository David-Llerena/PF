# Supabase — Project Settings > API
# Solo claves públicas: la anon key está protegida por las políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# URL pública de la app (para enlaces de confirmación y recuperación de contraseña)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NUNCA agregues SUPABASE_SERVICE_ROLE_KEY con prefijo NEXT_PUBLIC_.
# Esta versión no necesita la service role key.
